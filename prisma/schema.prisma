// VideoMaster schema. Every store-owned table carries storeId; child tables
// that reference other store-owned rows use composite (storeId, id) foreign
// keys so the database itself prevents cross-store references.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Auth & ownership ─────────────────────────

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  passwordHash       String
  createdAt          DateTime       @default(now())
  isDemo             Boolean        @default(false)
  sessions           Session[]
  memberships        StoreMember[]
  loginAttempts      LoginAttempt[]
  transactions       Transaction[]
  voidedTransactions Transaction[]  @relation("TransactionVoidedBy")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique // sha256 of the cookie token; raw token is never stored
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Failed-login log used for rate limiting (works across serverless instances).
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String // normalized email or ip
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([key, createdAt])
}

enum StoreRole {
  OWNER
  MANAGER
  EMPLOYEE
}

// A user may access a store only through a membership row.
model StoreMember {
  id        String    @id @default(cuid())
  userId    String
  storeId   String
  role      StoreRole @default(OWNER)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
}

// ───────────────────────── Store ─────────────────────────

model Store {
  id                    String   @id @default(cuid())
  name                  String
  number                String
  address               String
  city                  String
  region                String
  postalCode            String
  phone                 String
  managerName           String
  slogan                String?
  nextMembershipNumber  Int      @default(1)
  nextCopyNumber        Int      @default(1)
  nextTransactionNumber Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  members              StoreMember[]
  settings             StoreSettings?
  formats              StoreFormat[]
  rentalCategories     RentalCategory[]
  customers            Customer[]
  movieTitles          MovieTitle[]
  inventoryCopies      InventoryCopy[]
  rentals              Rental[]
  transactions         Transaction[]
  concessionItems      ConcessionItem[]
  transactionItems     TransactionItem[]
  concessionCategories ConcessionCategory[]
}

model StoreSettings {
  storeId                  String   @id
  currency                 String   @default("USD")
  timezone                 String   @default("America/Phoenix") // IANA zone; drives "today", due dates, lateness, reports
  salesTaxPercent          Decimal  @db.Decimal(6, 3)
  storeYear                Int?
  onlyMoviesUpToStoreYear  Boolean  @default(false)
  // Optional fees (0 = not charged)
  rewindFee                Decimal  @default(0) @db.Decimal(8, 2)
  damageFee                Decimal  @default(0) @db.Decimal(8, 2)
  lostItemFee              Decimal  @default(0) @db.Decimal(8, 2)
  replacementFee           Decimal  @default(19.99) @db.Decimal(8, 2) // default replacement cost for new copies
  // Membership rules
  membershipFee            Decimal  @default(0) @db.Decimal(8, 2)
  membershipTermMonths     Int      @default(0) // 0 = never expires
  maxRentalsOut            Int      @default(0) // 0 = unlimited
  // System settings
  functionKeys             Boolean  @default(false) // F1-F9 keyboard shortcuts (off by default: they are browser keys)
  receiptFooter            String   @default("THANK YOU!")
  // Inventory settings
  defaultLowStockThreshold Int      @default(5) // prefilled for new merchandise items
  updatedAt                DateTime @updatedAt
  store                    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

enum MediaFormat {
  VHS
  DVD
  BLURAY
  LASERDISC
  VIDEO_GAME
  OTHER
}

model StoreFormat {
  id                String          @id @default(cuid())
  storeId           String
  format            MediaFormat
  enabled           Boolean         @default(false)
  // Preselected rental category when adding copies of this format (how a store prices formats differently).
  defaultCategoryId String?
  defaultCategory   RentalCategory? @relation("FormatDefaultCategory", fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  store             Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, format])
}

enum ReplacementBehavior {
  NONE
  ITEM_COST
  FLAT_FEE
}

model RentalCategory {
  id                  String              @id @default(cuid())
  storeId             String
  name                String
  rentalPrice         Decimal             @db.Decimal(8, 2)
  rentalDays          Int
  lateFeePerDay       Decimal             @db.Decimal(8, 2)
  maxLateFee          Decimal?            @db.Decimal(8, 2)
  replacementBehavior ReplacementBehavior @default(ITEM_COST)
  taxable             Boolean             @default(true)
  active              Boolean             @default(true)
  sortOrder           Int                 @default(0)
  store               Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventoryCopies     InventoryCopy[]
  formatDefaults      StoreFormat[]       @relation("FormatDefaultCategory")

  @@unique([storeId, id])
  @@index([storeId])
}

// ───────────── Skeletons for later milestones (kept minimal) ─────────────

enum CustomerStatus {
  GOOD
  OVERDUE
  BLOCKED
  SUSPENDED
  CLOSED
}

model Customer {
  id                  String         @id @default(cuid())
  storeId             String
  membershipNumber    String
  firstName           String
  lastName            String
  phone               String?
  phoneDigits         String? // digits-only copy of phone, for search
  email               String?
  address             String?
  city                String?
  region              String?
  postalCode          String?
  dateOfBirth         DateTime?      @db.Date
  status              CustomerStatus @default(GOOD)
  notes               String?
  outstandingFees     Decimal        @default(0) @db.Decimal(8, 2)
  membershipPaidAt    DateTime?
  membershipExpiresAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  store               Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rentals             Rental[]
  transactions        Transaction[]

  @@unique([storeId, id])
  @@unique([storeId, membershipNumber])
  @@index([storeId, lastName, firstName])
}

model MovieTitle {
  id             String          @id @default(cuid())
  storeId        String
  title          String
  year           Int?
  tmdbId         Int? // external metadata id; stored so a movie is never duplicated in a store
  overview       String?
  posterPath     String? // TMDB-relative path, e.g. /abc.jpg
  director       String?
  runtimeMinutes Int?
  genres         String[]
  cast           String[]
  rating         String? // e.g. PG-13
  searchText     String          @default("") // lowercase director/genres/cast for search
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  copies         InventoryCopy[]

  @@unique([storeId, id])
  @@unique([storeId, tmdbId])
  @@index([storeId, title])
}

enum CopyStatus {
  AVAILABLE
  RENTED
  OVERDUE
  LOST
  DAMAGED
  REPAIR
  RETIRED
}

// One row per physical copy — never a quantity column.
model InventoryCopy {
  id               String          @id @default(cuid())
  storeId          String
  movieTitleId     String
  copyNumber       String // e.g. T2-0001
  format           MediaFormat
  status           CopyStatus      @default(AVAILABLE)
  condition        String?
  barcode          String?
  notes            String?
  replacementCost  Decimal?        @db.Decimal(8, 2)
  rentalCategoryId String?
  acquiredAt       DateTime        @default(now())
  store            Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  movieTitle       MovieTitle      @relation(fields: [storeId, movieTitleId], references: [storeId, id], onDelete: Cascade)
  rentalCategory   RentalCategory? @relation(fields: [storeId, rentalCategoryId], references: [storeId, id])
  rentals          Rental[]

  @@unique([storeId, id])
  @@unique([storeId, copyNumber])
  @@unique([storeId, barcode])
  @@index([storeId, movieTitleId])
}

enum RentalOutcome {
  RETURNED
  DAMAGED
  LOST
}

model Rental {
  id                  String         @id @default(cuid())
  storeId             String
  customerId          String
  copyId              String
  transactionId       String?
  price               Decimal        @default(0) @db.Decimal(8, 2) // rental price actually charged
  rentedAt            DateTime       @default(now())
  dueAt               DateTime
  returnedAt          DateTime?
  outcome             RentalOutcome?
  calculatedLateFee   Decimal?       @db.Decimal(8, 2) // what policy says
  chargedLateFee      Decimal?       @db.Decimal(8, 2) // what was actually charged (waived/reduced)
  otherFee            Decimal?       @db.Decimal(8, 2) // damage / lost-item fee
  rewindFee           Decimal?       @db.Decimal(8, 2)
  refundedAt          DateTime? // rental charge refunded
  returnTransactionId String?
  store               Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer            Customer       @relation(fields: [storeId, customerId], references: [storeId, id])
  copy                InventoryCopy  @relation(fields: [storeId, copyId], references: [storeId, id])
  transaction         Transaction?   @relation("RentalCheckout", fields: [transactionId], references: [id])
  returnTransaction   Transaction?   @relation("RentalReturn", fields: [returnTransactionId], references: [id])

  @@index([storeId, customerId])
  @@index([storeId, copyId])
  @@index([storeId, returnedAt])
  @@index([transactionId])
  @@index([returnTransactionId])
}

enum TransactionType {
  RENTAL
  RETURN
  RETAIL_SALE
  LATE_FEE
  REFUND
  FEE_WAIVER
  DAMAGE_FEE
  LOST_ITEM_FEE
  MEMBERSHIP_FEE
  ACCOUNT_PAYMENT
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT
  CHECK
  STORE_CREDIT
  OTHER
}

model Transaction {
  id              String            @id @default(cuid())
  storeId         String
  number          Int
  type            TransactionType   @default(RENTAL)
  customerId      String?
  createdById     String?
  subtotal        Decimal           @default(0) @db.Decimal(10, 2)
  tax             Decimal           @default(0) @db.Decimal(10, 2)
  total           Decimal           @default(0) @db.Decimal(10, 2)
  paymentMethod   PaymentMethod     @default(CASH)
  // Signed effect on the customer's account balance: fees put on account (+), payments and waivers (-).
  // Customer.outstandingFees always equals the sum of this column over the customer's non-voided transactions.
  balanceChange   Decimal           @default(0) @db.Decimal(10, 2)
  tendered        Decimal?          @db.Decimal(10, 2) // cash handed over (CASH payments with money due only); change = tendered - total
  notes           String?
  createdAt       DateTime          @default(now())
  // Voids: a mistaken rental/sale undone in full (rentals removed, stock and copies restored). Excluded from all totals.
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  voidSnapshot    String? // what the void removed, e.g. "TERMINATOR 2 VHS-000001; C001 SOUR PATCH KIDS x1"
  // Refunds: a REFUND transaction points at the transaction it refunds. `refundedAt` marks a whole-fee refund
  // (RETURN / MEMBERSHIP_FEE transactions are refunded all-or-nothing).
  refundOfId      String?
  refundedAt      DateTime?
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer        Customer?         @relation(fields: [storeId, customerId], references: [storeId, id])
  createdBy       User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  voidedBy        User?             @relation("TransactionVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  refundOf        Transaction?      @relation("TransactionRefunds", fields: [refundOfId], references: [id])
  refunds         Transaction[]     @relation("TransactionRefunds")
  rentals         Rental[]          @relation("RentalCheckout")
  returnedRentals Rental[]          @relation("RentalReturn")
  items           TransactionItem[]

  @@unique([storeId, number])
  @@unique([storeId, id])
  @@index([storeId, createdAt])
}

// Retail merchandise (not rental inventory). quantityOnHand >= 0 is enforced by a DB CHECK constraint.
model ConcessionItem {
  id                String             @id @default(cuid())
  storeId           String
  sku               String
  name              String
  categoryId        String
  retailPrice       Decimal            @db.Decimal(8, 2)
  costPrice         Decimal?           @db.Decimal(8, 2)
  taxable           Boolean            @default(true)
  quantityOnHand    Int                @default(0)
  lowStockThreshold Int                @default(5)
  active            Boolean            @default(true)
  barcode           String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  category          ConcessionCategory @relation(fields: [storeId, categoryId], references: [storeId, id])
  store             Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  saleItems         TransactionItem[]

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@unique([storeId, id])
  @@index([storeId, categoryId])
}

// Merchandise lines on a transaction (rentals are linked via Rental.transactionId).
// Name/SKU/price are snapshots so history survives later edits to the catalog item.
enum TransactionItemKind {
  MERCHANDISE
  RENTAL // a refunded rental charge (negative line on a REFUND transaction)
  FEE // a refunded fee (negative line on a REFUND transaction)
}

model TransactionItem {
  id               String              @id @default(cuid())
  storeId          String
  transactionId    String
  concessionItemId String?
  sku              String
  description      String
  quantity         Int
  unitPrice        Decimal             @db.Decimal(8, 2)
  lineTotal        Decimal             @db.Decimal(10, 2)
  taxable          Boolean
  kind             TransactionItemKind @default(MERCHANDISE)
  refundedQty      Int                 @default(0) // units of this merchandise line already refunded
  store            Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  transaction      Transaction         @relation(fields: [storeId, transactionId], references: [storeId, id], onDelete: Cascade)
  concessionItem   ConcessionItem?     @relation(fields: [storeId, concessionItemId], references: [storeId, id])

  @@index([storeId, transactionId])
  @@index([storeId, concessionItemId])
}

// Merchandise categories, editable per store (CANDY, POPCORN, ...). The prefix is the letter used for auto SKUs (C001).
model ConcessionCategory {
  id        String           @id @default(cuid())
  storeId   String
  name      String
  prefix    String
  sortOrder Int              @default(0)
  active    Boolean          @default(true)
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items     ConcessionItem[]

  @@unique([storeId, id])
  @@unique([storeId, name])
  @@index([storeId])
}
