# Copy to .env and adjust. Never commit .env.

# Database connection used by the running app.
#  - Local:     postgresql://YOU@localhost:5432/videomaster
#  - Supabase:  the Shared Pooler in TRANSACTION mode (port 6543, host like aws-0-<region>.pooler.supabase.com,
#               user postgres.<project-ref>). Built for serverless: thousands of short-lived clients.
#               (Session mode, port 5432, allows only ~15 clients and runs out on serverless redeploys.)
DATABASE_URL="postgresql://USER@localhost:5432/videomaster"

# Optional: connection used only by `prisma migrate`. Falls back to DATABASE_URL.
# With Supabase, use the Shared Pooler in SESSION mode (port 5432): migrations need session features.
# With Neon-style hosts, use the direct (non-pooled) string.
# MIGRATE_DATABASE_URL=""

# Optional tuning for hosted databases.
# DB_POOL_MAX=3        # max connections per server instance (1-20, default 5; use 2-3 on serverless)
# DB_SSL=no-verify     # encrypt but skip certificate-chain verification (applied automatically for *.supabase.com/.co)

# TMDB movie metadata (server-side only). Use either the read access token or the API key.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
