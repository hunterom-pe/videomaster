# Copy to .env and adjust. Never commit .env.
# Runtime connection (on Netlify use your host's POOLED connection string).
DATABASE_URL="postgresql://USER@localhost:5432/videomaster"
# Optional: direct (non-pooled) connection used only for `prisma migrate`.
# MIGRATE_DATABASE_URL=""

# TMDB movie metadata (server-side only). Use either the read access token or the API key.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
